    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.7",
    "expo-sharing": "~57.0.8",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "expo-web-browser": "~57.0.1",
    "fast-xml-parser": "^5.11.0",
    "i18next": "^26.3.6",
    "posthog-react-native": "^4.58.0",
    "react": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-health-connect": "^4.1.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
