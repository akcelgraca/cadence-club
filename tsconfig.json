{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Sem isto, describe/it/expect ficam por declarar: este TypeScript já não
    // puxa os @types automaticamente (hoje só entram os que são importados).
    // "node" é para os testes que leem ficheiros (ver lib/i18n/keys.test.ts) —
    // o código da app corre em React Native e não tem estas APIs.
    "types": ["jest", "node"]
  },
  // supabase/ tem as migrações e a edge function send-push, que corre em Deno
  // (imports por URL, global Deno). É outro runtime — typecheck com a config da
  // app React Native só produz erros falsos.
  "exclude": ["node_modules", "assets/layout_social", "supabase"]
}
