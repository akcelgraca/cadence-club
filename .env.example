EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# PostHog — a *project* API key (Settings › Project › Project API key).
# Começa por `phc_`. A que começa por `phx_` é a personal API key: é lida de
# outro sítio, o SDK aceita-a na mesma e não entrega um único evento.
# O host tem de ser o da região onde o projeto foi criado:
#   EU  → https://eu.i.posthog.com   (recomendado: app portuguesa, RGPD)
#   US  → https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY="phc_mTdwdwzbXZvoy5GemBRyPkRzktUA33TdEKqRa7c5tfnK"
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# ── SMTP próprio ──────────────────────────────────────────────────────────
# Sem `EXPO_PUBLIC_` de propósito: tudo o que leva esse prefixo é embutido no
# bundle da app e fica legível para quem abrir o .apk. Estas variáveis são
# lidas SÓ pelo `npm run smtp:check`, que confirma as credenciais antes de as
# colares no painel do Supabase. A app nunca fala com o servidor de email.
# Ver `supabase/SMTP.md` para saber onde ir buscar cada valor.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx
SMTP_FROM=no-reply@teu-dominio.pt
SMTP_TEST_TO=o-teu-email@gmail.com
